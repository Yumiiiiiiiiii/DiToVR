{
  "name": "ditovr-desktop",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "node scripts/ui-notices.mjs --check && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 1420",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:build:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-local.ps1",
    "desktop:build:store": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-store.ps1"
  },
  "dependencies": {
    "@animate-ui/react": "2.4.2",
    "@base-ui/react": "1.9.0",
    "@tauri-apps/api": "^2.0.0",
    "lucide-react": "^0.468.0",
    "motion": "14.9.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
